---
import ThemeSync from '../components/ThemeSync.astro'
import ApiReferenceHeader from '../components/ApiReferenceHeader.astro'

interface Props {
  title: string
  lang?: 'en' | 'es'
}

const { title, lang = 'en' } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ThemeSync />
  </head>
  <body>
    <ApiReferenceHeader lang={lang} />
    <div id="app">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Header colors pulled from Starlight's teal theme (props.css) — update here if the theme changes */
  :root {
    --op-header-height: 3.5rem;
    --op-header-pad-x: 1rem;
    --op-header-bg: hsl(224, 19%, 97%);
    --op-header-border: hsl(224, 20%, 94%);
    --op-header-text: hsl(224, 14%, 16%);
    --op-header-muted: hsl(224, 7%, 36%);
  }

  html.dark {
    --op-header-bg: hsl(224, 14%, 16%);
    --op-header-border: hsl(224, 10%, 10%);
    --op-header-text: hsl(224, 20%, 94%);
    --op-header-muted: hsl(224, 6%, 56%);
  }

  @media (min-width: 50rem) {
    :root {
      --op-header-height: 4rem;
      --op-header-pad-x: 1.5rem;
    }
  }

  html,
  body {
    height: 100%;
    margin: 0;
  }

  body {
    display: flex;
    flex-direction: column;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }

  #app {
    flex: 1;
    min-height: 0;
    padding-top: var(--op-header-height);
  }
</style>
