---
import { Icon } from '@astrojs/starlight/components'
const { title, iconName, iconColor, href, newTab } = Astro.props

// Render the whole card as a link when an href is passed, otherwise as a div
const Element = href ? 'a' : 'div'
---

<Element
  class="card"
  href={href}
  target={href && newTab ? '_blank' : undefined}
  rel={href && newTab ? 'noopener noreferrer' : undefined}
>
  <p class="title">
    <Icon name={iconName} color={iconColor} size="1.3rem" />
    <span>{title}</span>
    {href && <Icon name="right-arrow" class="arrow" />}
  </p>
</Element>

<style>
  .card {
    display: block;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    margin: 0;
    box-shadow:
      0 12px 24px 0 rgba(0, 0, 0, 0.05),
      0 4px 8px 0 rgba(0, 0, 0, 0.05),
      0 1px 0 0 rgba(0, 0, 0, 0.05);
    background-color: #fff;
    color: inherit;
  }

  /* No underline on the card itself (when it is a link) or on links inside it */
  a.card,
  a.card:hover,
  .card :global(a),
  .card :global(a:hover) {
    text-decoration: none !important;
  }

  /* Hover feedback for clickable cards, in place of an underline */
  a.card:hover {
    border-color: rgba(0, 0, 0, 0.3);
  }

  html[data-theme='dark'] .card {
    color: #fff;
    background-color: #171d4f;
  }

  /* Keeps the title layout clean and on one line */
  .title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-weight: 600;
    font-size: medium;
  }

  /* Push the arrow to the far right of the title row */
  .title :global(.arrow) {
    margin-inline-start: auto;
  }
</style>
