---
// The API reference is a standalone page, outside Starlight, so it does not
// get Starlight's stylesheet. OpenPaymentsLogo relies on that stylesheet for
// `light:sl-hidden` / `dark:sl-hidden` and `--sl-nav-height`, so this header
// renders the two logo files itself and swaps them on the `dark` class that
// ThemeSync puts on <html>.
import lightLogo from '../assets/open-payments-logo-light.svg'
import darkLogo from '../assets/open-payments-logo-dark.svg'

interface Props {
  lang?: 'en' | 'es'
}

const { lang = 'en' } = Astro.props

const fallback =
  lang === 'es'
    ? { href: '/es/overview/getting-started/', label: '← Documentación' }
    : { href: '/overview/getting-started/', label: '← Documentation' }
---

<header class="op-header">
  <a href={lang === 'es' ? '/es/' : '/'} class="op-header__logo">
    <img
      src={lightLogo.src}
      width={lightLogo.width}
      height={lightLogo.height}
      alt="Open Payments"
      class="op-header__logo-img op-header__logo-img--light"
    />
    <img
      src={darkLogo.src}
      width={darkLogo.width}
      height={darkLogo.height}
      alt="Open Payments"
      class="op-header__logo-img op-header__logo-img--dark"
    />
  </a>
  <a href={fallback.href} class="op-header__back" id="back-link"
    >{fallback.label}</a
  >
</header>
<script is:inline>
  ;(function () {
    const ref = document.referrer
    if (!ref) return

    let refUrl
    try {
      refUrl = new URL(ref)
    } catch {
      // ignore invalid referrer URLs
      return
    }

    if (refUrl.origin !== location.origin) return
    // Came from within the API reference itself (e.g. a reload) — keep the
    // locale-appropriate default out to the docs instead of looping back
    // into /apis/ or /es/apis/.
    if (/^\/(es\/)?apis(\/|$)/.test(refUrl.pathname)) return

    const backLink = document.getElementById('back-link')
    if (backLink) {
      backLink.href = ref
    }
  })()
</script>

<style>
  .op-header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--op-header-height);
    padding: 0 var(--op-header-pad-x);
    background: var(--op-header-bg);
    border-bottom: 1px solid var(--op-header-border);
  }

  .op-header__logo {
    display: flex;
    align-items: center;
    min-width: 0;
    text-decoration: none;
  }

  .op-header__logo-img {
    height: var(--op-header-logo-height);
    width: auto;
  }

  /* Only one of the two is ever shown. The light file is the default, so the
     page is correct before any script runs. */
  .op-header__logo-img--dark {
    display: none;
  }

  :global(html.dark) .op-header__logo-img--light {
    display: none;
  }

  :global(html.dark) .op-header__logo-img--dark {
    display: block;
  }

  .op-header__back {
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--op-header-muted);
  }

  .op-header__back:hover {
    color: var(--op-header-text);
  }
</style>
