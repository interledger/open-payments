---
// Only one image is ever displayed, so both carry the same alt text. The hidden
// one leaves the accessibility tree with `display: none`. Print keeps the light
// logo, because the dark one is white on white paper.
import lightLogo from '../assets/open-payments-logo-light.svg'
import darkLogo from '../assets/open-payments-logo-dark.svg'

const { class: className } = Astro.props
---

<img
  src={darkLogo.src}
  width={darkLogo.width}
  height={darkLogo.height}
  alt="Open Payments"
  class:list={['logo', 'light:sl-hidden', 'print:hidden', className]}
/>
<img
  src={lightLogo.src}
  width={lightLogo.width}
  height={lightLogo.height}
  alt="Open Payments"
  class:list={['logo', 'dark:sl-hidden', 'print:block', className]}
/>

<style>
  /* Match the height Starlight gives its own logo, and let the width follow
     from the aspect ratio. The wordmark sits on two lines, so sizing by width
     first overflows the header bar. */
  .logo {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: 0 50%;
  }
</style>
